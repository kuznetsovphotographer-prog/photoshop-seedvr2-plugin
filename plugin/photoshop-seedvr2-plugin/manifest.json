{
  "manifestVersion": 5,
  "id": "com.local.photoshop.seedvr2-upscaler",
  "name": "SeedVR2 Upscaler",
  "version": "0.1.1",
  "main": "index.html",
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-23@1x.png",
      "scale": [1],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    },
    {
      "width": 46,
      "height": 46,
      "path": "icons/icon-46@2x.png",
      "scale": [2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "host": {
    "app": "PS",
    "minVersion": "24.0.0",
    "data": {
      "apiVersion": 2,
      "enableMenuRecording": true
    }
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  },
  "featureFlags": {
    "enableAlerts": true
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "seedvr2UpscalerPanel",
      "label": {
        "default": "SeedVR2 Upscaler"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-23@1x.png",
          "scale": [1],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["pluginList"]
        },
        {
          "width": 46,
          "height": 46,
          "path": "icons/icon-46@2x.png",
          "scale": [2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["pluginList"]
        }
      ],
      "minimumSize": {
        "width": 360,
        "height": 360
      },
      "maximumSize": {
        "width": 720,
        "height": 960
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 540
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 540
      }
    }
  ]
}
